VITE_API_BASE_URL=http://localhost:3001/api
VITE_USER_ID=
# Site token do tenant (Backoffice → Site tokens). Obrigatório: sem ele o login/registo/esqueci
# dos clientes dão 401 SITE_TOKEN_REQUIRED (CT-16) e a app recusa arrancar.
VITE_SITE_TOKEN=

# Estatísticas (Umami): a app pede o id à API com o site token — sem config
# extra. Basta o domínio estar definido no Backoffice → Estatísticas.

# Migração (OPCIONAL): URL da nova app após a migração.
# Se definida, a app mostra uma página de despedida com um botão para a nova morada.
# Se vazia ou ausente (padrão), a app funciona normalmente.
# VITE_MIGRATED_TO=https://ginasio-x.rufvision.com
